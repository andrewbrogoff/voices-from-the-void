{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us"}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "difficulty easy"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add -16 -16 47 15"}},
    {"op": "cmd", "args": {"command": "fill -8 118 -8 8 118 8 minecraft:dirt"}},
    {"op": "cmd", "args": {"command": "fill -8 119 -8 8 119 8 minecraft:grass_block"}},
    {"op": "cmd", "args": {"command": "fill 30 119 -2 34 119 2 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 0.5 0 30"}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "dump", "args": {"kind": "vftv:hush_client"},
     "expect": {"showing": false, "rules": true, "statuses": {"gt": 0}}},
    {"op": "cmd", "args": {"command": "give @s vftv:clearing_bell"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:hush_client"},
     "expect": {"showing": true, "lines[0]": "Nothing pools here.", "lines": {"len": 1}}},
    {"op": "screenshot", "args": {"name": "hush-none.png"}},
    {"op": "cmd", "args": {"command": "vftv flux add 0 120 0 30"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:hush_client"},
     "expect": {"lines[0]": "This ground holds 30 flux. It begins to hush at 50.",
                "lines[1]": "It pools at 0, 120, 0."}},
    {"op": "screenshot", "args": {"name": "hush-quiet.png"}},
    {"op": "cmd", "args": {"command": "vftv flux add 0 120 0 170"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "dump", "args": {"kind": "vftv:hush_client"},
     "expect": {"lines[0]": {"matches": "This ground holds \\d+ flux: enough to hush up to \\d+ blocks\\."}}},
    {"op": "screenshot", "args": {"name": "hush-hushing.png"}},
    {"op": "dump", "args": {"kind": "vftv:hush", "args": {"pos": [0, 120, 0], "radius": 12}},
     "expect": {"status": "readable", "flux": {"gte": 190}, "seep": "0,120,0"}},
    {"op": "wait_ticks", "args": {"ticks": 300}},
    {"op": "dump", "args": {"kind": "vftv:hush", "args": {"pos": [0, 120, 0], "radius": 12}},
     "expect": {"taken": {"gt": 3}, "hushedCount": {"gt": 3}, "flux": {"lt": 195}}},
    {"op": "look", "args": {"at": [0.5, 119, 4.5]}},
    {"op": "screenshot", "args": {"name": "hush-grown.png"}},
    {"op": "use", "args": {"target": "air", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:hush", "args": {"pos": [0, 120, 0], "radius": 12}},
     "expect": {"status": "readable"}},
    {"op": "screenshot", "args": {"name": "hush-rung.png"}},
    {"op": "cmd", "args": {"command": "summon vftv:hollow 3.5 120 3.5"}},
    {"op": "look", "args": {"at": [3.5, 120.4, 3.5]}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:hush", "args": {"pos": [0, 120, 0], "radius": 12}},
     "expect": {"hollows": {"gte": 1}}},
    {"op": "screenshot", "args": {"name": "hush-hollow.png"}},
    {"op": "cmd", "args": {"command": "tp @s 32.5 120 0.5 0 30"}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:hush_client"},
     "expect": {"muffled": false, "inHush": false}},
    {"op": "cmd", "args": {"command": "setblock 32 119 0 vftv:hushed_stone"}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:hush_client"},
     "expect": {"muffled": true, "inHush": true, "gains.hostile": 0.5}},
    {"op": "cmd", "args": {"command": "setblock 32 119 0 minecraft:glass"}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:hush_client"},
     "expect": {"muffled": false, "gains.hostile": 1.0}},
    {"op": "quit", "args": {}}
  ]
}
