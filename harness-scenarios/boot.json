{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "render"},
     "expect": {"backend": {"exists": true}, "softwareGl": true, "width": 1280, "height": 720}},
    {"op": "dump", "args": {"kind": "player"},
     "expect": {"gameMode": "creative", "dimension": "minecraft:overworld", "screen": ""}},
    {"op": "dump", "args": {"kind": "vftv:tick_budget"},
     "expect": {"enabled": true, "sections[0].section": "total", "sections[0].ticks": {"gt": 0}}},
    {"op": "options",
     "args": {"language": "en_us", "narrator": "system", "notificationDisplayTime": 2.0,
              "resourcePacks": ["harness-scenarios/packs/test-pack"]},
     "expect": {"language": "en_us", "narrator": "system", "notificationDisplayTime": 2.0,
                "resourcePacks": {"contains": "file/test-pack"}}},
    {"op": "cmd", "args": {"command": "forceload add 0 0"}},
    {"op": "cmd", "args": {"command": "setblock 0 119 0 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 0.5"}},
    {"op": "cmd", "args": {"command": "setblock 2 120 0 minecraft:gold_block"}},
    {"op": "wait_ticks", "args": {"ticks": 40}},
    {"op": "look", "args": {"at": [2.5, 120.5, 0.5]}},
    {"op": "screenshot", "args": {"name": "smoke.png"}},
    {"op": "disconnect", "args": {}},
    {"op": "join", "args": {}},
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "block", "pos": [2, 120, 0]},
     "expect": {"state": "minecraft:gold_block", "clientState": "minecraft:gold_block"}},
    {"op": "dump", "args": {"kind": "world"},
     "expect": {"loaded": true, "published": false, "gameTime": {"gt": 40}}},
    {"op": "screenshot", "args": {"name": "after-rejoin.png"}},
    {"op": "quit", "args": {}}
  ]
}
