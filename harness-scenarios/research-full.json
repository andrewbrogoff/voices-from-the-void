{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "world": "research_full",
  "freshWorld": true,
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "give @s vftv:choir_page[vftv:page=\"vftv:choir/beneath_the_notes\"]"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:research"},
     "expect": {"readable": true, "stage": 0, "learned": 0}},
    {"op": "look", "args": {"yaw": 0, "pitch": -80}},
    {"op": "use", "args": {"target": "air", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "The hand is too old for me yet."}},
    {"op": "cmd", "args": {"command": "vftv research stage @s 3"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "use", "args": {"target": "air", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "Tipped in."}},
    {"op": "dump", "args": {"kind": "vftv:research"},
     "expect": {"stage": 3, "learnedIds": {"contains": "vftv:choir/beneath_the_notes"},
                "revealedIds": {"contains": "vftv:silence_beneath"}, "trueView": false}},
    {"op": "screenshot", "args": {"name": "research-tipped-in.png"}},
    {"op": "cmd", "args": {"command": "vftv research grant @s vftv:silence_beneath"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:research"},
     "expect": {"learnedIds": {"contains": "vftv:silence_beneath"}, "trueView": true, "vacuosLinks": {"contains": "vftv:terra"}}},
    {"op": "dump", "args": {"kind": "chat"}, "expect": {"messages[*].text": {"contains": "learned vftv:silence_beneath"}}},
    {"op": "cmd", "args": {"command": "vftv research revoke @s vftv:silence_beneath"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:research"}, "expect": {"stage": 3, "trueView": false}},
    {"op": "cmd", "args": {"command": "vftv research grant @s nowhere:entry"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "dump", "args": {"kind": "chat"}, "expect": {"messages[*].text": {"contains": "No research entry nowhere:entry."}}},
    {"op": "cmd", "args": {"command": "vftv research reset @s"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:research"}, "expect": {"stage": 0, "learned": 0}},
    {"op": "cmd", "args": {"command": "vftv research grant @s all"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:research"}, "expect": {"stage": 4, "learned": {"gte": 50}}},
    {"op": "disconnect", "args": {}},
    {"op": "join", "args": {}},
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "vftv:research"}, "expect": {"stage": 4, "learned": {"gte": 50}}},
    {"op": "quit", "args": {}}
  ]
}
