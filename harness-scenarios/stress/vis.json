    {"op": "cmd", "args": {"command": "setblock -3 121 2 vftv:node{node:{format:1,id:0L,origin:\"starter\",type:\"vftv:windward\",clarity:\"steady\",aspects:[{aspect:\"vftv:aer\",max:30,current:30},{aspect:\"vftv:terra\",max:12,current:12}],regen:{tick:0L,interval:80,divisor:20},cultivation:{counters:{},sonus:0}}}"}},
