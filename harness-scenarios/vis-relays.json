{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us", "notificationDisplayTime": 3.0}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add 2984 2984 3016 3016"}},
    {"op": "cmd", "args": {"command": "fill 2997 119 2994 3012 119 3006 minecraft:smooth_stone"}},
    {"op": "cmd", "args": {"command": "fill 2997 120 2994 3012 124 3006 minecraft:air"}},
    {"op": "cmd", "args": {"command": "tp @s 3000.5 120 3000.5 -90 20"}},
    {"op": "cmd", "args": {"command": "setblock 3006 121 3000 vftv:node{node:{format:1,id:0L,origin:\"natural\",type:\"vftv:windward\",clarity:\"steady\",aspects:[{aspect:\"vftv:aer\",max:40,current:40},{aspect:\"vftv:terra\",max:20,current:20}],regen:{tick:0L,interval:80,divisor:20},cultivation:{counters:{},sonus:0}}}"}},
    {"op": "cmd", "args": {"command": "setblock 3005 121 3000 vftv:node_tap[facing=east]"}},
    {"op": "cmd", "args": {"command": "setblock 3003 120 3003 vftv:vis_relay"}},
    {"op": "cmd", "args": {"command": "setblock 3002 120 2998 vftv:wand_cradle"}},
    {"op": "cmd", "args": {"command": "give @s vftv:wand[vftv:wand_rod=\"vftv:wooden\",vftv:wand_cap=\"vftv:copper\",vftv:vis={format:1,pools:{}}]"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3003, 120, 3003]}, "expect": {"member": "relay", "unlinked": false, "network": 3}},
    {"op": "look", "args": {"at": [3002.5, 120.5, 2998.5]}},
    {"op": "use", "args": {"target": "block", "pos": [3002, 120, 2998], "face": "up", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3002, 120, 2998]}, "expect": {"member": "cradle", "cradled": true}},
    {"op": "wait_ticks", "args": {"ticks": 60}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3002, 120, 2998]}, "expect": {"cradled": true, "pools.vftv:aer": {"gte": 8}, "pools.vftv:terra": {"gte": 8}}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3006, 121, 3000]}, "expect": {"block": "vftv:node", "nodeId": {"gte": 1}}},
    {"op": "look", "args": {"at": [3004.0, 120.8, 3000.5]}},
    {"op": "screenshot", "args": {"name": "relay-base-charging.png"}},
    {"op": "hold_key", "args": {"keysym": "Shift_L", "action": "press"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "use", "args": {"target": "block", "pos": [3003, 120, 3003], "face": "up", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "A chord of 3 of 32 voices: 1 listening, 1 charging."}},
    {"op": "screenshot", "args": {"name": "relay-status-network.png"}},
    {"op": "use", "args": {"target": "block", "pos": [3005, 121, 3000], "face": "up", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": {"matches": "Listening to a steady Windward \\(no\\. \\d+\\)\\. Toward a clearer ring: 0 of 48\\."}}},
    {"op": "screenshot", "args": {"name": "relay-status-tap.png"}},
    {"op": "use", "args": {"target": "block", "pos": [3002, 120, 2998], "face": "up", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": {"matches": "Charging: \\d+ of 240\\."}}},
    {"op": "hold_key", "args": {"keysym": "Shift_L", "action": "release"}},
    {"op": "cmd", "args": {"command": "vftv research grant @s vftv:moving_nodes"}},
    {"op": "cmd", "args": {"command": "give @s vftv:bell_jar"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "look", "args": {"at": [3006.5, 121.5, 3000.5]}},
    {"op": "use", "args": {"target": "block", "pos": [3006, 121, 3000], "face": "west", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3006, 121, 3000]}, "expect": {"block": "minecraft:air"}},
    {"op": "hold_key", "args": {"keysym": "Shift_L", "action": "press"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "hotbar", "args": {"slot": 1}},
    {"op": "use", "args": {"target": "block", "pos": [3005, 121, 3000], "face": "up", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "Nothing to listen to."}},
    {"op": "hold_key", "args": {"keysym": "Shift_L", "action": "release"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "look", "args": {"at": [3009.5, 119.9, 2995.5]}},
    {"op": "use", "args": {"target": "block", "pos": [3009, 119, 2995], "face": "up", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3009, 120, 2995]}, "expect": {"block": "vftv:node", "nodeId": {"gte": 1}, "clarity": "steady"}},
    {"op": "screenshot", "args": {"name": "bell-jar-released.png"}},
    {"op": "cmd", "args": {"command": "give @s vftv:tuning_fork"}},
    {"op": "hotbar", "args": {"slot": 1}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "look", "args": {"yaw": 0, "pitch": -80}},
    {"op": "use", "args": {"target": "air", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:aspect"}, "expect": {"state": {"ne": "NO_ANSWER"}, "marker": {"ne": ""}}},
    {"op": "screenshot", "args": {"name": "sounding-moved-node.png"}},
    {"op": "disconnect", "args": {}},
    {"op": "join", "args": {}},
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3009, 120, 2995]}, "expect": {"block": "vftv:node", "clarity": "steady"}},
    {"op": "dump", "args": {"kind": "vftv:vis", "pos": [3003, 120, 3003]}, "expect": {"member": "relay", "network": 3}},
    {"op": "quit", "args": {}}
  ]
}
