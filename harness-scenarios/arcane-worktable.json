{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us"}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add 0 0"}},
    {"op": "cmd", "args": {"command": "fill -2 119 -2 2 119 4 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "fill -2 120 -2 2 122 4 minecraft:air"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 0.5 0 0"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 minecraft:crafting_table"}},
    {"op": "cmd", "args": {"command": "give @s vftv:wand[vftv:wand_rod=\"vftv:wooden\",vftv:wand_cap=\"vftv:copper\",vftv:vis={format:1,pools:{\"vftv:aer\":20,\"vftv:aqua\":20,\"vftv:ignis\":20,\"vftv:ordo\":20,\"vftv:perditio\":20,\"vftv:terra\":20}}]"}},
    {"op": "cmd", "args": {"command": "give @s minecraft:oak_slab 3"}},
    {"op": "cmd", "args": {"command": "give @s minecraft:copper_ingot 4"}},
    {"op": "cmd", "args": {"command": "give @s minecraft:amethyst_shard 1"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "look", "args": {"at": [0.5, 120.5, 2.0]}, "expect": {"crosshair.type": "block"}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "screen", "args": {}, "expect": {"open": true, "class": {"matches": ".*CraftingScreen"}}},
    {"op": "close_screen", "args": {}},
    {"op": "cmd", "args": {"command": "vftv research grant @s vftv:arcane_crafting"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "block", "pos": [0, 120, 2]},"expect": {"state": {"matches": "vftv:worktable.*"}}},
    {"op": "screen", "args": {}, "expect": {"open": false}},
    {"op": "screenshot", "args": {"name": "worktable-turned.png"}},
    {"op": "hotbar", "args": {"slot": 8}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "screen", "args": {}, "expect": {"open": true, "class": {"matches": ".*WorktableScreen"}}},
    {"op": "dump", "args": {"kind": "vftv:worktable"},
     "expect": {"open": true, "status": "NO_WAND", "line": "Place a wand here.", "cells": {"len": 0}}},
    {"op": "screenshot", "args": {"name": "worktable-no-wand.png"}},
    {"op": "gui_click", "args": {"slot": 38, "clickType": "quick_move"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:worktable"}, "expect": {"status": "NO_RECIPE", "line": ""}},
    {"op": "gui_click", "args": {"slot": 39, "button": 0}},
    {"op": "gui_click", "args": {"slot": 1, "button": 1}},
    {"op": "gui_click", "args": {"slot": 2, "button": 1}},
    {"op": "gui_click", "args": {"slot": 3, "button": 1}},
    {"op": "gui_click", "args": {"slot": 40, "button": 0}},
    {"op": "gui_click", "args": {"slot": 4, "button": 1}},
    {"op": "gui_click", "args": {"slot": 6, "button": 1}},
    {"op": "gui_click", "args": {"slot": 7, "button": 1}},
    {"op": "gui_click", "args": {"slot": 9, "button": 1}},
    {"op": "gui_click", "args": {"slot": 41, "button": 0}},
    {"op": "gui_click", "args": {"slot": 5, "button": 0}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:worktable"},
     "expect": {"status": "READY", "ready": true, "line": "Ready to make Bell.",
                "cells": {"len": 3}, "cells[0].aspect": "vftv:aer", "cells[0].cost": 8,
                "cells[0].short": false, "cells[0].tooltip[0]": "Aer: 8 (base 8)",
                "cells[0].tooltip[1]": "My wand holds 20 of 40.",
                "cells[0].tooltip[2]": "Caps ×1.00, gear −0%, warp ×1.00: ×1.00",
                "preview": {"contains": "Click to make one. Shift-click to make as many as I can."}}},
    {"op": "gui_hover", "args": {"x": 92, "y": 93}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "screenshot", "args": {"name": "worktable-ready-cost-tooltip.png"}},
    {"op": "gui_key", "args": {"key": "tab"}},
    {"op": "gui_key", "args": {"key": "enter"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:worktable"},
     "expect": {"output": {"matches": "1 .*bell"}, "refusal": 0, "status": "NO_RECIPE"}},
    {"op": "screenshot", "args": {"name": "worktable-crafted.png"}},
    {"op": "gui_click", "args": {"slot": 10, "clickType": "quick_move"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:worktable"}, "expect": {"output": ""}},
    {"op": "close_screen", "args": {}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "inventory"}},
    {"op": "quit", "args": {}}
  ]
}
