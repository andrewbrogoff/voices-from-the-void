{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 1200,
  "world": "warp_voices",
  "freshWorld": true,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "vftv:voices_client"},
     "expect": {"lines": 46, "phantomSounds": 4, "text": "", "apparition": false, "quietSent": false}},
    {"op": "cmd", "args": {"command": "vftv warp add @s temporary 3"}},
    {"op": "wait_ticks", "args": {"ticks": 620}},
    {"op": "cmd", "args": {"command": "vftv warp fire @s vftv:whisper"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:voices_client"},
     "expect": {"text": {"matches": ".+"}, "textVoid": false, "textTicks": {"gt": 0}}},
    {"op": "dump", "args": {"kind": "vftv:warp"}, "expect": {"players[0].checks": {"gte": 1}}},
    {"op": "screenshot", "args": {"name": "voice-line.png"}},
    {"op": "cmd", "args": {"command": "vftv warp add @s lasting 30"}},
    {"op": "wait_ticks", "args": {"ticks": 100}},
    {"op": "cmd", "args": {"command": "vftv warp fire @s vftv:drained"}},
    {"op": "wait_ticks", "args": {"ticks": 60}},
    {"op": "dump", "args": {"kind": "vftv:voices_client"}, "expect": {"drain": {"gte": 0.6, "lte": 0.65}}},
    {"op": "screenshot", "args": {"name": "colour-drain-peak.png"}},
    {"op": "cmd", "args": {"command": "vftv warp fire @s vftv:watcher"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:voices_client"}, "expect": {"apparition": true}},
    {"op": "screenshot", "args": {"name": "apparition.png"}},
    {"op": "wait_ticks", "args": {"ticks": 410}},
    {"op": "dump", "args": {"kind": "vftv:voices_client"}, "expect": {"apparition": false, "drain": 0}},
    {"op": "key", "args": {"mapping": "key.inventory"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:voices_client"}, "expect": {"quietSent": true}},
    {"op": "close_screen", "args": {}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:voices_client"}, "expect": {"quietSent": false}},
    {"op": "cmd", "args": {"command": "item replace entity @s weapon.mainhand with vftv:stilling_draught"}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "hold_use", "args": {"ticks": 40}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:warp"}, "expect": {"players[0].lasting": 26}},
    {"op": "dump", "args": {"kind": "resources", "namespace": "vftv"}, "expect": {"missing.lang": {"len": 0}}},
    {"op": "quit", "args": {}}
  ]
}
