{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us"}},
    {"op": "dump", "args": {"kind": "vftv:vis_client"}, "expect": {"rulesReceived": true, "shown": false}},
    {"op": "dump", "args": {"kind": "vftv:vis"}, "expect": {"readable": true}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add 0 0"}},
    {"op": "cmd", "args": {"command": "setblock 0 119 0 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 0.5 -90 0"}},
    {"op": "cmd", "args": {"command": "give @s vftv:wand[vftv:wand_rod=\"vftv:wooden\",vftv:wand_cap=\"vftv:copper\",vftv:vis={format:1,pools:{\"vftv:aer\":12,\"vftv:aqua\":3,\"vftv:ignis\":40,\"vftv:ordo\":0,\"vftv:perditio\":7,\"vftv:terra\":25}}]"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "cmd", "args": {"command": "setblock 3 120 -2 vftv:node{node:{format:1,id:0L,origin:\"starter\",type:\"vftv:wellspring\",clarity:\"clear\",aspects:[{aspect:\"vftv:aer\",max:32,current:32},{aspect:\"vftv:aqua\",max:32,current:32},{aspect:\"vftv:ignis\",max:32,current:32},{aspect:\"vftv:ordo\",max:32,current:32},{aspect:\"vftv:perditio\",max:32,current:32},{aspect:\"vftv:terra\",max:32,current:32}],regen:{tick:0L,interval:40,divisor:20},cultivation:{counters:{},sonus:0}}}"}},
    {"op": "cmd", "args": {"command": "setblock 3 120 0 vftv:node{node:{format:1,id:0L,origin:\"starter\",type:\"vftv:windward\",clarity:\"steady\",aspects:[{aspect:\"vftv:aer\",max:30,current:30},{aspect:\"vftv:ignis\",max:9,current:9},{aspect:\"vftv:terra\",max:12,current:12}],regen:{tick:0L,interval:80,divisor:20},cultivation:{counters:{},sonus:0}}}"}},
    {"op": "cmd", "args": {"command": "setblock 3 120 2 vftv:node{node:{format:1,id:0L,origin:\"starter\",type:\"vftv:hearth\",clarity:\"faint\",aspects:[{aspect:\"vftv:ignis\",max:16,current:16}],regen:{tick:0L,interval:160,divisor:20},cultivation:{counters:{},sonus:0}}}"}},
    {"op": "cmd", "args": {"command": "setblock 3 121 4 vftv:node{node:{format:1,id:0L,origin:\"starter\",type:\"mod:gone\",clarity:\"clear\",aspects:[{aspect:\"vftv:aer\",max:8,current:8}],regen:{tick:0L,interval:40,divisor:20},cultivation:{counters:{},sonus:0}}}"}},
    {"op": "wait_ticks", "args": {"ticks": 30}},
    {"op": "dump", "args": {"kind": "vftv:vis_client"},
     "expect": {"shown": true, "hand": "MAIN_HAND", "inert": false, "width": 52, "height": 114,
                "rows": {"len": 6}, "rows[0]": "12", "rows[1]": "3", "rows[2]": "40", "rows[5]": "25"}},
    {"op": "screenshot", "args": {"name": "vis-hud-and-nodes.png"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "item replace entity @s weapon.offhand with vftv:wand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:vis_client"},
     "expect": {"shown": true, "hand": "OFF_HAND", "inert": true, "lines": {"gte": 1}}},
    {"op": "screenshot", "args": {"name": "vis-hud-inert-offhand.png"}},
    {"op": "disconnect", "args": {}},
    {"op": "join", "args": {}},
    {"op": "wait_boot", "args": {"stableTicks": 20}},
    {"op": "dump", "args": {"kind": "vftv:vis_client"}, "expect": {"rulesReceived": true, "shown": true, "inert": true}}
  ]
}
