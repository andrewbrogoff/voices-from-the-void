{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us"}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add -16 -16 16 16"}},
    {"op": "cmd", "args": {"command": "fill -5 119 -3 5 119 7 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 -0.5 0 0"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 vftv:reliquary[facing=north]"}},
    {"op": "cmd", "args": {"command": "setblock 3 120 2 vftv:reliquary[facing=north]"}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "look", "args": {"at": [0.5, 120.6, 2.5]}, "expect": {"crosshair.type": "block"}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:worldgen", "pos": [0, 120, 2]},
     "expect": {"claimsReadable": true, "claims": {"len": 1}, "claims[0].pages[0]": "vftv:choir/beneath_the_notes",
                "claims[0].pos": "0, 120, 2", "pagesHeld": 1, "reliquary": "vftv:choir_ruin"}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "The reliquary yields its pages."}},
    {"op": "screenshot", "args": {"name": "reliquary-given.png"}},
    {"op": "cmd", "args": {"command": "clear @s vftv:choir_page"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:worldgen"}, "expect": {"claims": {"len": 1}, "pagesHeld": 1}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "It gives back what I lost."}},
    {"op": "cmd", "args": {"command": "vftv research stage @s 3"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "use", "args": {"target": "air", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:worldgen"}, "expect": {"pagesHeld": 0}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "Tipped in."}},
    {"op": "disconnect", "args": {}},
    {"op": "join", "args": {}},
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "vftv:worldgen", "pos": [0, 120, 2]},
     "expect": {"claims": {"len": 1}, "pagesHeld": 0, "reliquary": "vftv:choir_ruin"}},
    {"op": "look", "args": {"at": [0.5, 120.6, 2.5]}, "expect": {"crosshair.type": "block"}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "I have taken all that this reliquary holds for me."}},
    {"op": "look", "args": {"at": [3.5, 120.6, 2.5]}, "expect": {"crosshair.type": "block"}},
    {"op": "use", "args": {"target": "block", "pos": [3, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:text"}, "expect": {"latest": "I already hold every page these ruins keep."}},
    {"op": "dump", "args": {"kind": "vftv:worldgen"}, "expect": {"claims": {"len": 1}, "pagesHeld": 0}},
    {"op": "screenshot", "args": {"name": "reliquary-all-held.png"}},
    {"op": "dump", "args": {"kind": "resources", "namespace": "vftv"},
     "expect": {"missing.blockModels": {"len": 0}, "missing.itemModels": {"len": 0}, "missing.lang": {"len": 0}}},
    {"op": "quit", "args": {}}
  ]
}
