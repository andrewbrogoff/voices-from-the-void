{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 1200,
  "render": {"width": 854, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us"}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamerule advance_time false"}},
    {"op": "cmd", "args": {"command": "time set noon"}},
    {"op": "cmd", "args": {"command": "difficulty normal"}},
    {"op": "cmd", "args": {"command": "gamemode creative"}},
    {"op": "cmd", "args": {"command": "forceload add 1984 1984 2127 2127"}},
    {"op": "cmd", "args": {"command": "tp @s 2059 200 2059"}},
    {"op": "wait_ticks", "args": {"ticks": 100}},
    {"op": "cmd", "args": {"command": "place structure vftv:choir_ruin 2048 64 2048"}},
    {"op": "wait_ticks", "args": {"ticks": 40}},
    {"op": "dump", "args": {"kind": "vftv:worldgen"},
     "expect": {"answerers": {"gte": 2}, "cantors": 1, "choirSite": false}},
    {"op": "cmd", "args": {"command": "gamemode spectator"}},
    {"op": "cmd", "args": {"command": "tp @s 2160 115 2059"}},
    {"op": "wait_ticks", "args": {"ticks": 60}},
    {"op": "look", "args": {"at": [2059, 95, 2059]}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "screenshot", "args": {"name": "ruin-tower-100.png", "hideHud": true}},
    {"op": "cmd", "args": {"command": "tp @s 2059 150 2059"}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "look", "args": {"yaw": 0, "pitch": 90}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "screenshot", "args": {"name": "ruin-chancel-above.png", "hideHud": true}},
    {"op": "dump", "args": {"kind": "vftv:worldgen_client"}, "expect": {"answerers": {"gte": 2}, "cantors": 1}},
    {"op": "cmd", "args": {"command": "gamemode creative"}},
    {"op": "cmd", "args": {"command": "forceload add -16 -16 16 16"}},
    {"op": "cmd", "args": {"command": "fill -6 119 -9 6 119 9 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 -0.5 0 0"}},
    {"op": "cmd", "args": {"command": "summon vftv:answerer_cantor 0.5 120 4.5"}},
    {"op": "cmd", "args": {"command": "summon vftv:answerer 3.5 120 5.5"}},
    {"op": "cmd", "args": {"command": "effect give @s minecraft:resistance 300 4 true"}},
    {"op": "cmd", "args": {"command": "effect give @s minecraft:regeneration 300 4 true"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "look", "args": {"at": [0.5, 121.5, 4.5]}},
    {"op": "wait_ticks", "args": {"ticks": 30}},
    {"op": "dump", "args": {"kind": "vftv:worldgen"}, "expect": {"targeting": {"gte": 1}}},
    {"op": "wait_ticks", "args": {"ticks": 85}},
    {"op": "dump", "args": {"kind": "vftv:worldgen_client"}, "expect": {"chanting": true}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 -5.5 0 10"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "screenshot", "args": {"name": "answerers-chant.png", "hideHud": true}},
    {"op": "cmd", "args": {"command": "gamemode creative"}},
    {"op": "dump", "args": {"kind": "resources", "namespace": "vftv"},
     "expect": {"missing.blockModels": {"len": 0}, "missing.lang": {"len": 0}}},
    {"op": "quit", "args": {}}
  ]
}
