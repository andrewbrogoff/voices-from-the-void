{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us"}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add -16 -16 16 16"}},
    {"op": "cmd", "args": {"command": "fill -5 119 -3 5 119 7 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 -0.5 0 0"}},
    {"op": "cmd", "args": {"command": "vftv research grant @s vftv:echo_wands"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 vftv:singing_bowl{infusion:{format:1,id:5L,runs:0,item:{id:\"vftv:resonant_brass_cap\",count:1}}}"}},
    {"op": "cmd", "args": {"command": "setblock 2 120 2 vftv:pedestal{infusion:{format:1,item:{id:\"minecraft:echo_shard\",count:1}}}"}},
    {"op": "cmd", "args": {"command": "setblock -2 120 2 vftv:pedestal{infusion:{format:1,item:{id:\"minecraft:amethyst_shard\",count:1}}}"}},
    {"op": "cmd", "args": {"command": "setblock 3 120 3 minecraft:amethyst_cluster"}},
    {"op": "cmd", "args": {"command": "setblock -3 120 1 minecraft:amethyst_cluster"}},
    {"op": "cmd", "args": {"command": "give @s vftv:wand"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "look", "args": {"at": [0.5, 120.7, 2.5]}, "expect": {"crosshair.type": "block"}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:infusion"},
     "expect": {"showing": true, "kind": "ARMED", "status": "READY", "cells": 3,
                "lines[0]": "It will make Echo Cap.", "lines[2]": "Stability 95%",
                "lines[6]": "Strike again to begin."}},
    {"op": "screenshot", "args": {"name": "infusion-ready.png"}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 25}},
    {"op": "dump", "args": {"kind": "vftv:infusion"},
     "expect": {"showing": true, "kind": "RUN", "status": "RINGING",
                "lines[0]": "Ringing toward Echo Cap.",
                "lines[4]": "Waiting for essentia. Waiting costs nothing."}},
    {"op": "screenshot", "args": {"name": "infusion-ringing.png"}},
    {"op": "hotbar", "args": {"slot": 1}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 15}},
    {"op": "dump", "args": {"kind": "vftv:infusion"},
     "expect": {"kind": "RUN", "lines[6]": "Take it out again to abandon."}},
    {"op": "screenshot", "args": {"name": "infusion-abandon-armed.png"}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:infusion"}, "expect": {"has_readout": false}},
    {"op": "screenshot", "args": {"name": "infusion-abandoned.png"}},
    {"op": "quit", "args": {}}
  ]
}
