{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us", "notificationDisplayTime": 2.0},
     "expect": {"notificationDisplayTime": 2.0}},
    {"op": "dump", "args": {"kind": "vftv:essentia"},
     "expect": {"rules": true, "capacity": 100, "moteSpeed": 0.25, "moteSize": 0.25, "motes": 0}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode creative"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add -16 -16 16 16"}},
    {"op": "cmd", "args": {"command": "fill -1 199 -3 8 199 3 minecraft:smooth_stone"}},
    {"op": "cmd", "args": {"command": "setblock 1 200 0 vftv:essentia_jar[facing=south]{vftv:{format:1,aspect:\"vftv:aer\",amount:40}}"}},
    {"op": "cmd", "args": {"command": "setblock 2 200 0 vftv:essentia_tube[west=connected,east=connected]"}},
    {"op": "cmd", "args": {"command": "setblock 3 200 0 vftv:essentia_tube[west=connected,east=connected,south=blocked]{vftv:{format:1,label:\"vftv:aer\"}}"}},
    {"op": "cmd", "args": {"command": "setblock 4 200 0 vftv:essentia_tube[west=connected,east=connected]"}},
    {"op": "cmd", "args": {"command": "setblock 5 200 0 vftv:essentia_jar[facing=south]{vftv:{format:1,label:\"vftv:aer\"}}"}},
    {"op": "cmd", "args": {"command": "setblock 1 200 2 vftv:essentia_jar[facing=south]{vftv:{format:1,aspect:\"vftv:ignis\",amount:15}}"}},
    {"op": "cmd", "args": {"command": "setblock 3 200 2 vftv:essentia_jar[facing=south]{vftv:{format:1,label:\"vftv:terra\"}}"}},
    {"op": "cmd", "args": {"command": "setblock 5 200 2 vftv:essentia_jar[facing=south]{vftv:{format:1,aspect:\"vftv:ghost\",amount:50}}"}},
    {"op": "cmd", "args": {"command": "tp @s 3.5 201.6 4.2 180 30"}},
    {"op": "wait_ticks", "args": {"ticks": 25}},
    {"op": "screenshot", "args": {"name": "essentia-line-flowing.png"}},
    {"op": "wait_ticks", "args": {"ticks": 80}},
    {"op": "dump", "args": {"kind": "vftv:essentia", "pos": [5, 200, 0]},
     "expect": {"readable": true, "aspect": "vftv:aer", "amount": 40, "label": "vftv:aer"}},
    {"op": "dump", "args": {"kind": "vftv:essentia", "pos": [1, 200, 0]},
     "expect": {"readable": true, "aspect": "", "amount": 0}},
    {"op": "dump", "args": {"kind": "vftv:essentia", "pos": [5, 200, 2]},
     "expect": {"aspect": "vftv:ghost", "amount": 50}},
    {"op": "screenshot", "args": {"name": "essentia-jars-glyphs.png"}},
    {"op": "cmd", "args": {"command": "tp @s 3.5 200.4 1.6 180 35"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "screenshot", "args": {"name": "essentia-band-close.png"}},
    {"op": "disconnect", "args": {}},
    {"op": "join", "args": {}},
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "vftv:essentia", "pos": [5, 200, 0]},
     "expect": {"rules": true, "amount": 40, "label": "vftv:aer"}},
    {"op": "quit", "args": {}}
  ]
}
