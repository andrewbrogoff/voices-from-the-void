{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us"}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "forceload add 0 0"}},
    {"op": "cmd", "args": {"command": "fill -2 119 -2 2 119 4 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 0.5 0 0"}},
    {"op": "cmd", "args": {"command": "setblock 0 119 2 minecraft:magma_block"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 vftv:crucible[water=true,boiling=true]{crucible:{format:1,pool:{\"vftv:aer\":30,\"vftv:ignis\":12,\"vftv:gone\":5}}}"}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "look", "args": {"at": [0.5, 120.6, 2.5]},
     "expect": {"crosshair.type": "block"}},
    {"op": "wait_ticks", "args": {"ticks": 10}},
    {"op": "dump", "args": {"kind": "vftv:crucible"},
     "expect": {"showing": true, "boiling": true, "water": true, "unreadable": false, "capacity": 200,
                "total": 47, "cells": 3, "lines[0]": "Boiling: 47 of 200",
                "lines[1]": "Emptying it spills 47 flux.", "pool.vftv:gone": 5}},
    {"op": "screenshot", "args": {"name": "crucible-boiling.png"}},
    {"op": "cmd", "args": {"command": "summon minecraft:item 0.5 120.5 2.5 {Item:{id:\"vftv:tuning_fork\",count:1},Motion:[0d,0d,0d]}"}},
    {"op": "wait_ticks", "args": {"ticks": 30}},
    {"op": "dump", "args": {"kind": "vftv:crucible"},
     "expect": {"total": 53, "pool.vftv:sonus": 2, "pool.vftv:metallum": 2}},
    {"op": "screenshot", "args": {"name": "crucible-dissolved.png"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 vftv:crucible[water=true,boiling=true]{crucible:{format:1,pool:{\"vftv:x00\":1000,\"vftv:x01\":1000,\"vftv:x02\":1000,\"vftv:x03\":1000,\"vftv:x04\":1000,\"vftv:x05\":1000,\"vftv:x06\":1000,\"vftv:x07\":1000,\"vftv:x08\":1000,\"vftv:aer\":100,\"vftv:ignis\":100,\"vftv:terra\":100,\"vftv:aqua\":100}}}"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:crucible"},
     "expect": {"total": 9400, "cells": 12, "lines[0]": "Boiling: 9400 of 200",
                "lines[1]": "… and 1 more"}},
    {"op": "screenshot", "args": {"name": "crucible-many.png"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 vftv:crucible[water=true,boiling=true]{crucible:{format:2,pool:{\"vftv:aer\":1}}} replace"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:crucible"},
     "expect": {"unreadable": true, "lines[0]": "I can't read what's in it.", "cells": 0}},
    {"op": "screenshot", "args": {"name": "crucible-unreadable.png"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 minecraft:air"}},
    {"op": "cmd", "args": {"command": "setblock 0 120 2 vftv:crucible"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:crucible"},
     "expect": {"water": false, "boiling": false, "lines[0]": "Dry: 0 of 200", "lines": {"len": 1}}},
    {"op": "screenshot", "args": {"name": "crucible-dry.png"}},
    {"op": "cmd", "args": {"command": "give @s minecraft:water_bucket"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:crucible"},
     "expect": {"water": true, "boiling": true, "lines[0]": "Boiling: 0 of 200"}},
    {"op": "dump", "args": {"kind": "inventory"}},
    {"op": "use", "args": {"target": "block", "pos": [0, 120, 2], "face": "north", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 5}},
    {"op": "dump", "args": {"kind": "vftv:crucible"}, "expect": {"water": false}},
    {"op": "quit", "args": {}}
  ]
}
