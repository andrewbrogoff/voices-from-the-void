{
  "projectDir": "..",
  "gradleTask": "runHarnessClient",
  "timeoutSeconds": 900,
  "render": {"width": 640, "height": 480},
  "steps": [
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "options", "args": {"language": "en_us", "notificationDisplayTime": 2.0},
     "expect": {"notificationDisplayTime": 2.0}},
    {"op": "dump", "args": {"kind": "vftv:aspect"},
     "expect": {"arrivals": 0, "cardShowing": false, "knowledgeReadable": true, "scans": 0}},
    {"op": "cmd", "args": {"command": "gamerule send_command_feedback false"}},
    {"op": "cmd", "args": {"command": "gamemode survival"}},
    {"op": "cmd", "args": {"command": "clear @s"}},
    {"op": "cmd", "args": {"command": "give @s vftv:tuning_fork 2"}},
    {"op": "cmd", "args": {"command": "forceload add 0 0"}},
    {"op": "cmd", "args": {"command": "setblock 0 119 0 minecraft:glass"}},
    {"op": "cmd", "args": {"command": "tp @s 0.5 120 0.5 0 0"}},
    {"op": "cmd", "args": {"command": "setblock 2 120 0 minecraft:chest"}},
    {"op": "hotbar", "args": {"slot": 0}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "look", "args": {"at": [2.5, 120.5, 0.5]}},
    {"op": "use", "args": {"target": "block", "pos": [2, 120, 0], "face": "west", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "screen", "args": {}, "expect": {"open": false}},
    {"op": "dump", "args": {"kind": "vftv:aspect"},
     "expect": {"arrivals": 1, "cardShowing": true, "state": "NOTHING", "name": "Chest",
                "lines[0]": "Nothing answers.", "remaining": {"gte": 110},
                "narrated": {"contains": "Nothing answers."}, "narrations": 1}},
    {"op": "screenshot", "args": {"name": "strike-card-nothing.png"}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "look", "args": {"yaw": 0, "pitch": -80}},
    {"op": "use", "args": {"target": "air", "hand": "main_hand"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "dump", "args": {"kind": "vftv:aspect"},
     "expect": {"arrivals": 2, "state": "NO_ANSWER", "lines[0]": "No answer.", "marker": "",
                "narrated": {"contains": "No answer."}}},
    {"op": "screenshot", "args": {"name": "sounding-no-answer.png"}},
    {"op": "wait_ticks", "args": {"ticks": 20}},
    {"op": "gui_click", "args": {"slot": 37, "button": 0}},
    {"op": "gui_click", "args": {"slot": 36, "button": 1}},
    {"op": "wait_ticks", "args": {"ticks": 3}},
    {"op": "dump", "args": {"kind": "vftv:aspect"},
     "expect": {"arrivals": 3, "state": "SCANNED", "name": "Tuning Fork", "entries": 4, "unheard": 4,
                "lines[0]": "Some of it I can't yet hear.", "scans": 1, "known": 0,
                "narrated": {"contains": "something unheard"}}},
    {"op": "gui_click", "args": {"slot": 37, "button": 0}},
    {"op": "look", "args": {"yaw": 0, "pitch": 10}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "screenshot", "args": {"name": "strike-card-unheard.png"}},
    {"op": "hold_key", "args": {"keysym": "Shift_L", "action": "press"}},
    {"op": "wait_ticks", "args": {"ticks": 2}},
    {"op": "dump", "args": {"kind": "vftv:aspect"},
     "expect": {"tooltip[0]": "Carry the fork and right-click an item to strike it.",
                "tooltip": {"len": 5}, "tooltip[1]": {"contains": "something unheard"}}},
    {"op": "hold_key", "args": {"keysym": "Shift_L", "action": "release"}},
    {"op": "disconnect", "args": {}},
    {"op": "join", "args": {}},
    {"op": "wait_boot", "args": {"stableTicks": 40}},
    {"op": "dump", "args": {"kind": "vftv:aspect"},
     "expect": {"knowledgeReadable": true, "scans": 1, "known": 0, "cardShowing": false}},
    {"op": "quit", "args": {}}
  ]
}
